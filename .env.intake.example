# Copy into this checkout's .env, or select a separate file with INTAKE_ENV_FILE.
# Existing shell environment values take precedence. Restart dev after edits.
# Start with the owned fake inventory (including supervised fake apply).
INTAKE_TARGET_PROFILE=fake
INTAKE_DEV_PORT=4330
INTAKE_PROCESSING_PROFILE=synthetic-research/2

# To read the local development InvenTree (`pnpm inventree:dev`), use
# INTAKE_TARGET_PROFILE=local-inventree instead. pnpm dev starts it and reads its
# token from private state; leave the read-only settings below unset.

# To read an external InvenTree server, replace the profile above with read-only
# and uncomment these values. Use a dedicated read-only server API token.
# INTAKE_READ_ORIGIN=https://inventory.example.invalid
# INTAKE_CREDENTIAL_REF=development_inventory
# INTAKE_DEV_API_KEY=replace-with-your-read-only-token

# Optional private app-state override, outside the repository.
# INTAKE_APP_STATE=../private-intake-state

# Native agents are explicit opt-in.
# INTAKE_PROCESSING_PROFILE=native-agent/2 proposes lots from photos.
# INTAKE_PROCESSING_PROFILE=native-agent/1 queues one result for a saved lot or part.
# OPENAI_API_KEY=replace-with-your-own-key
# ANTHROPIC_API_KEY=replace-with-your-own-key
# Codex subscription login for this dev app: pnpm codex:login
# See docs/development.md. Do not copy a Codex authentication store.
