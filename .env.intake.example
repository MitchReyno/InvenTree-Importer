# Copy into this checkout's .env, or select a separate file with INTAKE_ENV_FILE.
# Existing shell environment values take precedence. Restart dev after edits.
# Switches take true or false (or 1 and 0); leave a line out to keep its default.
INTAKE_DEV_PORT=4330

# ── Inventory ────────────────────────────────────────────────────────────────
# With nothing set, the app uses the built-in mock inventory, which supports Apply.
# true = the mock, even if the local or external settings below are also set.
# INTAKE_USE_MOCK_INVENTREE=true

# true = the local development InvenTree (`pnpm inventree:dev`); pnpm dev starts it.
# INTAKE_USE_LOCAL_INVENTREE=true

# An external InvenTree server. Use a dedicated read-only API token.
# INTAKE_INVENTREE_URL=https://inventory.example.invalid
# INTAKE_INVENTREE_TOKEN=replace-with-your-read-only-token
# Defaults to inventree_<host>; set it to keep a namespace made with an earlier reference.
# INTAKE_CREDENTIAL_REF=development_inventory

# true = never write, whichever inventory is selected. Defaults to false for the
# mock and true otherwise; writes to a real server are not supported.
# INTAKE_INVENTREE_READ_ONLY=true

# ── Processing ───────────────────────────────────────────────────────────────
# Scripted agents by default; false = real Claude/Codex agents.
# INTAKE_USE_MOCK_AI_AGENTS=false
# false = one result per stage instead of Examine sessions.
# INTAKE_USE_AGENT_SESSIONS=false
# true = run agents through the shared VM (needs INTAKE_VM_PAIR and INTAKE_VM_PORT).
# INTAKE_RUN_AGENTS_IN_VM=true
# false = real VM agents without the tool worker and web reader.
# INTAKE_VM_AGENT_TOOLS=false
# With real agents in the VM, name the paired Lima instance to have pnpm dev boot it, run its
# credential tunnels and relays, and stop the VM on exit if this run booted it.
# INTAKE_VM_NAME=bench-agent-m1
# INTAKE_VM_GUEST_DIR=/var/tmp/bench-personal
# INTAKE_VM_RUNNER_IMAGE=bench-intake-runner:personal
# true = leave a VM this run booted running after the app stops.
# INTAKE_VM_KEEP_RUNNING=true
# OPENAI_API_KEY=replace-with-your-own-key
# ANTHROPIC_API_KEY=replace-with-your-own-key
# Codex subscription login for this dev app: pnpm codex:login
# See docs/development.md. Do not copy a Codex authentication store.

# Optional private app-state override, outside the repository.
# INTAKE_APP_STATE=../private-intake-state
