{
  "name": "@invimport/intake-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../tooling/dev/api.cjs",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:pg": "tsx --test --test-concurrency=1 tests/pg/*.test.ts",
    "test:process": "tsx --test --test-concurrency=1 tests/process/*.test.ts",
    "migrate": "tsx src/operations/migrate-main.ts",
    "db:dev": "node scripts/dev-services.cjs",
    "apply:manual": "tsx src/review/runner-main.ts",
    "media:decode": "tsx src/media/worker-main.ts",
    "media:gc": "tsx src/media/gc-main.ts",
    "preview:manual": "tsx tests/fixtures/manual-browser.ts",
    "preview:attachments": "tsx tests/fixtures/part-attachment-browser.ts",
    "operations": "tsx src/operations/main.ts",
    "agents:run": "tsx src/agents/worker-main.ts"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "5.4.0",
    "@fastify/static": "10.1.8",
    "@fastify/websocket": "11.3.6",
    "@invimport/contracts": "workspace:*",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/canvas": "1.1.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ipaddr.js": "2.5.0",
    "pdfjs-dist": "6.4.299",
    "pg": "8.16.3",
    "sharp": "0.35.5",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.15.6",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
