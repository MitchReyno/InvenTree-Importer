{
  "name": "@invimport/intake-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:pg": "tsx --test tests/pg/*.test.ts",
    "test:process": "tsx --test tests/process/*.test.ts",
    "migrate": "tsx src/operations/migrate-main.ts",
    "db:dev": "node scripts/dev-services.cjs"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "5.4.0",
    "@fastify/static": "10.1.8",
    "@invimport/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.15.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
