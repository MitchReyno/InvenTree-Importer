    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/react": "0.5.3",
    "@fontsource-variable/public-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@invimport/contracts": "workspace:*",
    "@radix-ui/react-popover": "1.3.1",
    "@tanstack/react-query": "5.105.1",
    "fuse.js": "7.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-moveable": "0.56.0",
    "react-select": "5.10.2",
    "styled-components": "6.6.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
