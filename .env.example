# Copy to .env, then fill in only the credentials you need. Everything else has a
# default; the commented lines show it. Shell environment values take precedence.
# Restart `pnpm dev` after edits.
#
# Leave an unknown value EMPTY: a comment on the same line as an empty value is read
# as the value itself. An empty value counts as unset.
# Switches take true or false (or 1 and 0).

# ── Importer: InvenTree server ───────────────────────────────────────────────
# The server `invimport` writes to. Left empty, it uses the local development
# InvenTree once `pnpm inventree:dev up` has run, and says so.
# INVENTREE_URL is the server origin, e.g. https://inventory.example.com
INVENTREE_URL=
# An API token (preferred), or a user and password.
INVENTREE_TOKEN=
INVENTREE_USER=
INVENTREE_PASSWORD=

# Download and attach every datasheet URL on import-stock runs, as if
# --mirror-datasheets were passed. Default off.
# INVIMPORT_MIRROR_DATASHEETS=1

# ── Importer: DigiKey ────────────────────────────────────────────────────────
# Register at https://developer.digikey.com/ and subscribe the app to each API
# product: Product Information for `product`, OrderStatus for `orders`.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# Your account ID, from the portal's 'My Account' page; needed for order history.
DIGIKEY_ACCOUNT_ID=

# Locale. Site one of: US, CA, JP, UK, DE, AT, BE, DK, FI, GR, IE, IT, LU, NL, NO,
# PT, ES, KR, HK, SG, CN, TW, AU, FR, IN, NZ, SE, MX, CH, IL, PL, SK, SI, LV, LT,
# EE, CZ, HU, BG, MY, ZA, RO, TH, PH, BR, VN.
# DIGIKEY_LOCALE_SITE=US
# Currency one of: USD, CAD, JPY, GBP, EUR, HKD, SGD, TWD, KRW, AUD, NZD, INR, DKK,
# NOK, SEK, ILS, CNY, PLN, CHF, CZK, HUF, RON, ZAR, MYR, THB, PHP.
# DIGIKEY_LOCALE_CURRENCY=USD
# Language one of: en, ja, de, fr, ko, zhs, zht, it, es, he, nl, sv, pl, fi, da, no.
# DIGIKEY_LOCALE_LANGUAGE=en

# ── App (pnpm dev) ───────────────────────────────────────────────────────────
# With nothing set, the app runs on the mock inventory with scripted agents.
# INTAKE_DEV_PORT=4330
# Optional private app-state override, outside the repository.
# INTAKE_APP_STATE=../private-intake-state

# ── App: inventory ───────────────────────────────────────────────────────────
# true = the mock, even if the local or external settings below are also set.
# INTAKE_USE_MOCK_INVENTREE=true
# true = the local development InvenTree (`pnpm inventree:dev`); pnpm dev starts it.
# INTAKE_USE_LOCAL_INVENTREE=true
# An external InvenTree for the app to read. Use a dedicated read-only API token.
# INTAKE_INVENTREE_URL=https://inventory.example.invalid
# INTAKE_INVENTREE_TOKEN=replace-with-your-read-only-token
# Defaults to inventree_<host>; set it to keep a namespace made with an earlier reference.
# INTAKE_CREDENTIAL_REF=development_inventory
# true = never write. Defaults to false for the mock and true otherwise; writes to a
# real server are not supported.
# INTAKE_INVENTREE_READ_ONLY=true

# ── App: agents ──────────────────────────────────────────────────────────────
# Scripted agents by default; false = real Claude/Codex agents.
# INTAKE_USE_MOCK_AI_AGENTS=false
# false = one result per stage instead of Examine sessions.
# INTAKE_USE_AGENT_SESSIONS=false
# Real agents on this machine use your Claude and Codex sign-ins (Codex: pnpm codex:login),
# or these keys. Do not copy a Codex authentication store.
# OPENAI_API_KEY=replace-with-your-own-key
# ANTHROPIC_API_KEY=replace-with-your-own-key

# ── App: agents in the shared VM ─────────────────────────────────────────────
# true = run agents in the VM. With real agents, pnpm dev boots the VM, runs its
# credential tunnel and relays, and stops the VM on exit if this run booted it.
# Pair the VM first (README, "VM agent runner").
# INTAKE_RUN_AGENTS_IN_VM=true
# false = run the VM side yourself instead.
# INTAKE_VM_MANAGED=false
# false = real VM agents without the tool worker and web reader.
# INTAKE_VM_AGENT_TOOLS=false
# true = leave a VM this run booted running after the app stops.
# INTAKE_VM_KEEP_RUNNING=true
# The defaults below match the README walkthrough.
# INTAKE_VM_NAME=bench-agent
# INTAKE_VM_PORT=14313
# Default: vm-pair in the development state directory (~/.local/state/bench-intake).
# INTAKE_VM_PAIR=/absolute/path/to/vm-pair
# Default: bench-intake-guest in the guest user's home, looked up after boot.
# INTAKE_VM_GUEST_DIR=/home/you.guest/bench-intake-guest
# INTAKE_VM_RUNNER_IMAGE=bench-intake-runner:personal
