# Copy to .env and fill in. Values must be left EMPTY if unknown - do not put
# a placeholder after the '=', because a comment on the same line as an empty
# value is read as the value itself.

# Inventree API credentials
# INVENTREE_URL points at your instance, e.g. http://localhost if running it locally
INVENTREE_URL=
INVENTREE_USER=
INVENTREE_PASSWORD=

# DigiKey API credentials
# Register for a developer account at https://developer.digikey.com/
# The app must be subscribed to each API product separately: Product
# Information for `product`, OrderStatus for `orders`.
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# Your DigiKey account ID, required to fetch order history.
# Found on the 'My Account' page of the developer portal.
DIGIKEY_ACCOUNT_ID=

# DigiKey locale site (country). One of:
#   US, CA, JP, UK, DE, AT, BE, DK, FI, GR, IE, IT, LU, NL, NO, PT, ES, KR, HK,
#   SG, CN, TW, AU, FR, IN, NZ, SE, MX, CH, IL, PL, SK, SI, LV, LT, EE, CZ, HU,
#   BG, MY, ZA, RO, TH, PH, BR, VN
DIGIKEY_LOCALE_SITE=US

# DigiKey locale currency. One of:
#   USD, CAD, JPY, GBP, EUR, HKD, SGD, TWD, KRW, AUD, NZD, INR, DKK, NOK, SEK,
#   ILS, CNY, PLN, CHF, CZK, HUF, RON, ZAR, MYR, THB, PHP
DIGIKEY_LOCALE_CURRENCY=USD

# DigiKey locale language. One of:
#   en, ja, de, fr, ko, zhs, zht, it, es, he, nl, sv, pl, fi, da, no
DIGIKEY_LOCALE_LANGUAGE=en
