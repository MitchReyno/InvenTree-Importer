{
  "name": "@invimport/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./json": "./src/json.ts",
    "./client": "./generated/client.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "generate": "node scripts/generate.cjs",
    "check:generated": "node scripts/generate.cjs --check"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "json-schema-to-typescript": "16.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
