{
  "name": "inventree-importer-workspace",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @invimport/frontend dev",
    "build": "pnpm --filter @invimport/frontend build",
    "typecheck": "pnpm --filter @invimport/frontend typecheck && pnpm run typecheck:intake",
    "typecheck:intake": "pnpm --filter @invimport/contracts typecheck && pnpm --filter @invimport/intake-server typecheck",
    "dev:intake": "pnpm --filter @invimport/intake-server dev",
    "contracts:generate": "pnpm --filter @invimport/contracts generate",
    "contracts:check": "pnpm --filter @invimport/contracts check:generated",
    "db:intake": "pnpm --filter @invimport/intake-server db:dev",
    "lint": "pnpm run lint:readability && pnpm run lint:frontend && pnpm run lint:backend && pnpm run lint:markdown",
    "lint:frontend": "pnpm --filter @invimport/frontend lint",
    "lint:backend": "uv run --directory backend ruff check --config pyproject.toml . ../.agents/skills ../.claude/skills",
    "lint:markdown": "remark . --ignore-path .gitignore --ignore-pattern '.claude/worktrees/**' --ignore-pattern '.amp/**' --frail --no-stdout",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:python": "uv run --project backend ruff format --config backend/pyproject.toml --force-exclude",
    "format:python:check": "uv run --project backend ruff format --config backend/pyproject.toml --force-exclude --check",
    "format:markdown": "remark . --ignore-path .gitignore --ignore-pattern '.claude/worktrees/**' --ignore-pattern '.amp/**' --output",
    "hooks:install": "uv run --project backend pre-commit install",
    "hooks:check": "uv run --project backend pre-commit run --all-files",
    "test:formatting": "node --test tooling/tests/formatting.test.mjs",
    "test": "pnpm run test:frontend && pnpm run test:intake && pnpm run test:backend",
    "test:intake": "pnpm --filter @invimport/contracts test && pnpm --filter @invimport/intake-server test",
    "test:intake:pg": "pnpm --filter @invimport/intake-server test:pg",
    "test:intake:process": "pnpm --filter @invimport/intake-server test:process",
    "test:frontend": "pnpm --filter @invimport/frontend test",
    "test:backend": "uv run --directory backend pytest -m \"not tui\"",
    "backend": "uv run --project backend invimport",
    "demo": "uv run --project backend invimport demo",
    "test:scanner": "uv run --directory backend --extra scanner pytest -m tui",
    "test:all": "uv run --directory backend --extra scanner pytest -m \"\" && pnpm run test:frontend && pnpm run test:intake",
    "workflow-sync": "uv run --directory backend pytest tests/test_project_workflow_sync.py",
    "spikes:check": "uv run --directory backend pytest tests/spikes/test_shared_contracts.py",
    "lint:readability": "eslint --config eslint.config.mjs frontend/src intake-server/src contracts/src --max-warnings 0",
    "test:readability": "node --test tooling/tests/readability.test.mjs",
    "format:readability": "eslint --config eslint.config.mjs frontend/src intake-server/src contracts/src --fix --max-warnings 0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "remark-cli": "12.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-preset-lint-recommended": "7.0.1",
    "typescript-eslint": "8.72.1"
  }
}
