{
  "name": "inventree-importer-workspace",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @invimport/frontend dev",
    "build": "pnpm --filter @invimport/frontend build",
    "typecheck": "pnpm --filter @invimport/frontend typecheck",
    "lint": "pnpm run lint:frontend && pnpm run lint:backend && pnpm run lint:markdown",
    "lint:frontend": "pnpm --filter @invimport/frontend lint",
    "lint:backend": "uv run --directory backend ruff check --config pyproject.toml . ../.agents/skills ../.claude/skills",
    "lint:markdown": "remark . --ignore-path .gitignore --ignore-pattern '.claude/worktrees/**' --ignore-pattern '.amp/**' --frail --no-stdout",
    "format:markdown": "remark . --ignore-path .gitignore --ignore-pattern '.claude/worktrees/**' --ignore-pattern '.amp/**' --output",
    "hooks:install": "uv run --project backend pre-commit install",
    "hooks:check": "uv run --project backend pre-commit run --all-files",
    "test": "pnpm run test:frontend && pnpm run test:backend",
    "test:frontend": "pnpm --filter @invimport/frontend test",
    "test:backend": "uv run --directory backend pytest -m \"not tui\"",
    "backend": "uv run --project backend invimport",
    "demo": "uv run --project backend invimport demo",
    "test:scanner": "uv run --directory backend --extra scanner pytest -m tui",
    "test:all": "uv run --directory backend --extra scanner pytest -m \"\" && pnpm run test:frontend",
    "workflow-sync": "uv run --directory backend pytest tests/test_project_workflow_sync.py"
  },
  "devDependencies": {
    "remark-cli": "12.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-preset-lint-recommended": "7.0.1"
  }
}
